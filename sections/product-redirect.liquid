{% comment %}
  Save this as a new file: sections/product-redirect.liquid
{% endcomment %}

{%- style -%}
  .sold-out-redirect {
    margin: 20px 0;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 4px;
    text-align: center;
  }
  
  .sold-out-redirect .button {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 20px;
    background-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: 4px;
  }
{%- endstyle -%}

<script>
  // Function to handle variant change and check redirect
  function handleVariantChange_{{ section.id }}() {
    const selectElements = document.querySelectorAll('select[name="id"], input[name="id"]');
    const currentVariantId = Array.from(selectElements).find(el => el.checked || el.selected)?.value;
    
    if (currentVariantId) {
      const variantData = {
        {% for variant in product.variants %}
          {{ variant.id }}: {
            available: {{ variant.available }},
            redirectUrl: {{ variant.metafields.custom.redirect_url | json }},
            buttonText: {{ variant.metafields.custom.redirect_button_text | default: section.settings.default_button_text | json }},
            messageText: {{ variant.metafields.custom.redirect_message | default: section.settings.default_message | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      };
      
      const currentVariant = variantData[currentVariantId];
      const redirectDiv = document.querySelector('.sold-out-redirect-{{ section.id }}');
      
      if (!currentVariant.available && currentVariant.redirectUrl) {
        if (redirectDiv) {
          redirectDiv.style.display = 'block';
          
          // Update message text
          const messageElement = redirectDiv.querySelector('.redirect-message');
          if (messageElement) {
            messageElement.textContent = currentVariant.messageText;
          }
          
          // Update button text and URL
          const redirectButton = redirectDiv.querySelector('.redirect-button');
          if (redirectButton) {
            redirectButton.href = currentVariant.redirectUrl;
            redirectButton.textContent = currentVariant.buttonText;
          }
        }
      } else {
        if (redirectDiv) {
          redirectDiv.style.display = 'none';
        }
      }
    }
  }

  // Add event listeners for variant selectors
  document.addEventListener('DOMContentLoaded', function() {
    const selectElements = document.querySelectorAll('select[name="id"], input[name="id"]');
    selectElements.forEach(element => {
      element.addEventListener('change', function() {
        handleVariantChange_{{ section.id }}();
      });
    });
    
    // Initial check
    handleVariantChange_{{ section.id }}();
  });
</script>

<div class="sold-out-redirect-{{ section.id }}" style="display: none;">
  <p class="redirect-message"></p>
  <a href="#" class="button redirect-button"></a>
</div>

{% schema %}
{
  "name": "Product Redirect",
  "tag": "section",
  "class": "product-redirect-section",
  "settings": [
    {
      "type": "text",
      "id": "default_message",
      "label": "Default Redirect Message",
      "default": "This variant is currently sold out. We have an alternative available."
    },
    {
      "type": "text",
      "id": "default_button_text",
      "label": "Default Button Text",
      "default": "View Alternative"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Product Redirect"
    }
  ]
}
{% endschema %}