<div class="t4s-product-img t4s_ratio" {{ imgatt }}style="--aspect-ratioapt: {{ image.aspect_ratio | default: 1 }}">
    <img data-pr-img class="t4s-product-main-img" src="{{ image | image_url: width: 600 }}" width="{{ image.width }}" height="{{ image.height }}" alt="{% if image.alt %}{{ image.alt | escape }}{% else %}{{ shop.name }}{% endif %}">
    <span class="lazyloadt4s-loader" role="presentation"></span>
    <div data-replace-img2></div>
    <noscript><img class="t4s-product-main-img" loading="lazy" src="{{ image | image_url: width: 600 }}" width="{{ image.width }}" height="{{ image.height }}" alt="{% if image.alt %}{{ image.alt | escape }}{% else %}{{ shop.name }}{% endif %}"></noscript>
</div>